<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="Diagnostic-ApiValidation" BeforeTargets="Build">
    <Message Text="DIAG: EnableApiValidation = $(EnableApiValidation)" Importance="high" />
    <Message Text="DIAG: DriverPackageType = $(DriverPackageType)" Importance="high" />
    <Message Text="DIAG: DriverTargetPlatform = $(DriverTargetPlatform)" Importance="high" />
    <Message Text="DIAG: Directory.Build.targets imported from $(MSBuildProjectDirectory)" Importance="high" />
  </Target>
  <PropertyGroup>
    <EnableApiValidation>false</EnableApiValidation>
  </PropertyGroup>
</Project>
